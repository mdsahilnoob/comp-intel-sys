{
  "name": "comp-intel-sys",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:cloudflare": "pnpm --filter @comp-intel/web cf-build",
    "start": "turbo run start",
    "deploy:cloudflare": "pnpm --filter @comp-intel/web exec wrangler deploy",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.10.12"
  }
}
